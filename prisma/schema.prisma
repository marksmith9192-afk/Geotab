 generator client {
   provider = "prisma-client-js"
 }
 
 datasource db {
   provider = "sqlite"
   url      = env("DATABASE_URL")
 }
 
model Job {
  id               String          @id @default(cuid())
  status           String
  dryRun           Boolean
  requestedBy      String
  templateFileName String
  selectedCount    Int
  successCount     Int             @default(0)
  failureCount     Int             @default(0)
  createdAt        String
  updatedAt        String
  completedAt      String?
  templateUpload   TemplateUpload? @relation(fields: [templateUploadId], references: [id])
  templateUploadId String?
  items            JobItem[]
  auditEntries     AuditEntry[]
}
 
model JobItem {
  id             String        @id @default(cuid())
  job            Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId          String
  reportId       String
  reportName     String
  status         String
  details        String?
  errorMessage   String?
  beforeSnapshot Json?
  afterSnapshot  Json?
  backup         ReportBackup? @relation(fields: [backupId], references: [id])
  backupId       String?
  createdAt      String
  updatedAt      String
}
 
model ReportBackup {
  id                 String    @id @default(cuid())
  reportId           String
  reportName         String
  templateFileName   String?
  backupPayload      Json
  storagePath        String?
  restorable         Boolean   @default(false)
  createdAt          String
  restoredAt         String?
  restoredByJobItems JobItem[]
}
 
model AuditEntry {
  id         String   @id @default(cuid())
  job        Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId      String?
  reportId   String?
  reportName String?
  level      String
  action     String
  message    String
  metadata   Json?
  createdAt  String
}
 
model TemplateUpload {
  id           String   @id @default(cuid())
  originalName String
  storedName   String
  mimeType     String?
  sizeBytes    Int
  storagePath  String
  createdAt    String
  jobs         Job[]
}
